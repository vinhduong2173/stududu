# PostgreSQL (khớp docker-compose.yml ở repo root)
DATABASE_URL="postgresql://stududu:stududu@localhost:5432/stududu?schema=public"

# JWT — đổi secret trước khi deploy
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="30m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Gọi thoại — ICE server (audio-call-design.md mục 7)
# STUN miễn phí, không cần đăng ký. Nhiều URL thì ngăn cách bằng dấu phẩy.
STUN_URLS="stun:stun.l.google.com:19302"
# TURN: đăng ký Open Relay (https://www.metered.ca/tools/openrelay/) rồi điền vào .env
# — KHÔNG commit credential. Thiếu TURN thì gọi giữa 2 mạng khác nhau có thể thất bại.
TURN_URLS=""
TURN_USERNAME=""
TURN_CREDENTIAL=""
