# PostgreSQL (khớp docker-compose.yml ở repo root)
DATABASE_URL="postgresql://stududu:stududu@localhost:5432/stududu?schema=public"

# JWT — đổi secret trước khi deploy
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="30m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Gọi thoại — ICE server (audio-call-design.md mục 7)
# STUN miễn phí, không cần đăng ký. Nhiều URL thì ngăn cách bằng dấu phẩy.
STUN_URLS="stun:stun.l.google.com:19302"
# TURN: đăng ký Open Relay (https://www.metered.ca/tools/openrelay/) rồi điền vào .env
# — KHÔNG commit credential. Thiếu TURN thì gọi giữa 2 mạng khác nhau có thể thất bại.
TURN_URLS=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# AI sinh câu hỏi cho bộ đề (question-set-ai-generation-addendum.md)
# Gemini có gói miễn phí — lấy khoá tại https://aistudio.google.com/apikey
# KHÔNG commit key thật. Thiếu key thì luồng AI báo lỗi rõ ràng, Admin vẫn nhập tay được.
GEMINI_API_KEY=""
# Model dùng để sinh câu hỏi — để trống sẽ dùng gemini-2.5-flash
GEMINI_MODEL="gemini-2.5-flash"

# EP-11 — Subscription & thanh toán (SRS-ST~1.MD §7)
# URL frontend, dùng để dựng link quay lại sau khi thanh toán.
FRONTEND_URL="http://localhost:3000"
# Đặt "false" để tắt job nền dunning (§5.3) khi chạy test/CI.
SUBSCRIPTION_JOBS_ENABLED="true"
# Stripe TEST MODE (§7.2). Có STRIPE_SECRET_KEY thì hệ thống tự dùng Stripe;
# để trống thì rơi về MockProvider (phương án dự phòng R-01).
# KHÔNG commit key thật — kể cả key test.
#
# Lấy key: https://dashboard.stripe.com/test/apikeys  (key test bắt đầu bằng sk_test_)
STRIPE_SECRET_KEY=""
# Lấy secret webhook: chạy `stripe listen --forward-to localhost:5000/webhooks/stripe`
# rồi copy chuỗi whsec_... mà lệnh in ra. Thiếu bước này subscription sẽ kẹt
# vĩnh viễn ở pending_payment (§7.3).
STRIPE_WEBHOOK_SECRET=""
# Tuỳ chọn: Price ID định kỳ tạo sẵn trên Dashboard. Để trống thì hệ thống tự
# dựng giá inline 29.000 VND/tháng (VND là zero-decimal, không nhân 100).
STRIPE_PRICE_ID=""
